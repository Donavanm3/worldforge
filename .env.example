NODE_ENV=development

# PostgreSQL 16 + PostGIS (see docker-compose.dev.yml)
DATABASE_URL=postgresql://wf:wf@localhost:5432/wf

# Redis 7 (see docker-compose.dev.yml)
REDIS_URL=redis://localhost:6379

# Server
PORT=3001
WEB_PORT=3000

# Public origin the game is served from. Used to build API and WebSocket URLs.
# Replace with your own domain; nothing may hard-code this value.
PUBLIC_URL=http://localhost:3000

# Auth. Generate with: openssl rand -base64 48
JWT_SECRET=
SESSION_SECRET=

# Payment provider (beta access). Server-side keys only — never expose these to
# the browser, and never grant access from a success URL alone (spec 67).
PAYMENT_PROVIDER=stripe
PAYMENT_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=
PAYMENT_PUBLISHABLE_KEY=
