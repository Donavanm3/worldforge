{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // The web app is bundled by Vite rather than emitted by tsc, so it leaves
    // the composite project graph: no declarations, no incremental output.
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "incremental": false,
    "noEmit": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "allowImportingTsExtensions": true
  },
  "include": ["src/**/*", "vite.config.ts"]
}
